                ItemStatus = "Available",
                Messages = new List<ChatMessage>
                {
                    new ChatMessage { IsMe = false, Text = "Hey bro, is the price for the MacBook Pro negotiable?", Time = "Mon 10:11 AM" },
                    new ChatMessage { IsMe = true, Text = "A little bit, what is your offer?", Time = "Mon 10:15 AM" },
