                }
            },
            new ChatSession
            {
                Id = "chat-2",
                Name = "Sarah Khan",
                AvatarUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuBvPyGfvVctS3fzE8fDyNwawtrNb3vO65aOiloy2DZCHf2GwMRSkFaBKL6QN4DnCIpGNTyodykQ27APOGEurerNiPdJkAH_pyws_HHZ4dTrUJN0oZmx5yh9CAhiVF0wUjVy-salafqCyN1hXO7-dcqwfppV3HMZ-kzM4hF6s9lVH3hS0URX1qPeMrV1W9ydWUbKR0iff6wGE7BB7k54JMipexRMUczl4E1ieBzH98gnULYqDtyGIhFNUlY-4WwGvT1cSLHlhN_1eRk",
