        // Handle dynamically routed listings (e.g. from the Contact Seller button on details page!)
        if (ListingId.HasValue)
        {
            var targetListing = await DbContext.Listings.FindAsync(ListingId.Value);
            if (targetListing != null)
            {
                // Check if a session already exists with this seller email and item ID
                var existingSession = conversations.FirstOrDefault(c => c.ItemId == targetListing.Id);
                if (existingSession != null)
                {
                    activeChatId = existingSession.Id;
                }
                else
                {
                    // Look up custom seller avatar url in DB
                    var sellerUser = await DbContext.Users.FirstOrDefaultAsync(u => u.Email == targetListing.SellerEmail);
                    var avatarUrl = sellerUser?.ProfilePictureUrl ?? "https://lh3.googleusercontent.com/aida-public/AB6AXuDecJwkdbQ-rmoX14-09GUl5NJfxLb4zvKE6SBT92JVFe9GTfMojhHGHocwOcERXACoN4lQ88buCP6H5_POtOjYVP6hcVZ7Ifth31G7rAc6bVUalQNovtbB_0_gCCt45YEN6EDkE2r8WTILQH1B9D9fuPfxRP1tS8E5iOZpeTkXXqLqVTrtKQyJvKcugJbYnntPk3FtKDVUdMhK-JulcK-bpVvJkjD_gyOVSnb6JamoDuXOsaN8J-4vE2dq8_Xx1lAFv90do9oIuy8";
                    
                    var newSessionId = $"chat-{conversations.Count + 1}";
                    var newSession = new ChatSession
                    {
                        Id = newSessionId,
                        Name = targetListing.SellerName,
                        AvatarUrl = avatarUrl,
                        LastMessageTime = "Just now",
                        ItemId = targetListing.Id,
                        ItemTitle = targetListing.Title,
                        ItemPrice = targetListing.Price,
                        ItemImageUrl = targetListing.ImageUrl,
