                    conversations.Insert(0, newSession);
                    activeChatId = newSessionId;
                    
                    // Trigger dynamic mock reply in background
#pragma warning disable CS4014
                    _ = TriggerMockResponse(newSession);
#pragma warning restore CS4014
                }
            }
        }
    }

    private void SelectConversation(string id)
    {
        activeChatId = id;
        typedMessage = "";
        isTyping = false;
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(typedMessage) || activeChat == null) return;

        var text = typedMessage.Trim();
        typedMessage = "";

        // Add my message
        var myMsg = new ChatMessage
        {
            IsMe = true,
            Text = text,
            Time = DateTime.Now.ToString("h:mm tt")
        };
        activeChat.Messages.Add(myMsg);
        activeChat.LastMessageTime = DateTime.Now.ToString("h:mm tt");

        // Mock automated response
        await TriggerMockResponse(activeChat);
    }

    private async Task TriggerMockResponse(ChatSession session)
    {
        isTyping = true;
        StateHasChanged();

        // 1.5 second typing simulation
        await Task.Delay(1500);
        
        isTyping = false;
        
        // Select smart replies based on sender name
        string replyText = session.Name switch
        {
            "Hassan Ali" => "Awesome, thank you! I will park there and text you when I arrive at 4:30 PM. See you soon!",
            "Sarah Khan" => "You're welcome! Good luck with your studies and semester projects!",
            "Abdul-Rehman" => "175k works for me if we can meet tomorrow at the main campus café. Let me know!",
            _ => $"Hey! Yes, the {session.ItemTitle} is still available. I can meet you on campus near the library tomorrow, does that work for you?"
        };

        var replyMsg = new ChatMessage
        {
            IsMe = false,
            Text = replyText,
            Time = DateTime.Now.ToString("h:mm tt")
        };
        
        session.Messages.Add(replyMsg);
        session.LastMessageTime = DateTime.Now.ToString("h:mm tt");
        StateHasChanged();
    }

    public class ChatSession
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string AvatarUrl { get; set; } = "";
        public string LastMessageTime { get; set; } = "";
        public int ItemId { get; set; }
        public string ItemTitle { get; set; } = "";
        public int ItemPrice { get; set; }
        public string ItemImageUrl { get; set; } = "";
        public string ItemStatus { get; set; } = "";
        public List<ChatMessage> Messages { get; set; } = new();
    }

    public class ChatMessage
    {
        public bool IsMe { get; set; }
        public string Text { get; set; } = "";
        public string Time { get; set; } = "";
    }
}
