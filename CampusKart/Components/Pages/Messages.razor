@page "/messages"
@layout Layout.UserLayout
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Text.Json
@using CampusKart.Data
@using Microsoft.AspNetCore.SignalR.Client
@inject ApplicationDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>CampusKart | Messages</PageTitle>

<div class="container-fluid py-4" style="height: calc(100vh - 100px); max-height: 800px;">
    <div class="row h-100 g-3">
        <!-- Left Sidebar (Conversations List) -->
        <div class="col-md-4 col-lg-3 h-100 d-flex flex-column">
            <div class="bg-white border rounded-4 shadow-sm h-100 d-flex flex-column overflow-hidden" style="border-color: #e4e2e1 !important; border-radius: 1rem !important;">
                <!-- Header -->
                <div class="p-3 border-bottom bg-light" style="border-color: #e4e2e1 !important;">
                    <h2 class="fw-bold text-ck-primary m-0" style="font-size: 22px; color: #003f87;">Messages</h2>
                    <p class="text-ck-secondary small m-0 mt-1" style="color: #5d5f5f;">Chats with buyers & sellers</p>
                    
                    <!-- Search Bar -->
                    <div class="position-relative mt-3">
                        <span class="material-symbols-outlined position-absolute top-50 translate-middle-y ms-3 text-secondary fs-5">search</span>
                        <input type="text" class="form-control rounded-3 border-0 bg-light ps-5 small py-2" style="background-color: #f6f3f2 !important; border-radius: 0.5rem !important;"
                               placeholder="Search conversations..." @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>

                <!-- Conversation list -->
                <div class="flex-grow-1 overflow-y-auto" style="max-height: 520px;">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="text-ck-secondary small mt-2" style="color: #5d5f5f;">Loading chats...</p>
                        </div>
                    }
                    else if (FilteredConversations.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var chat in FilteredConversations)
                            {
                                var isActive = (activeChatId == chat.Id);
                                <button type="button" class="list-group-item list-group-item-action p-3 d-flex align-items-center gap-3 border-0 transition-all @(isActive ? "bg-light border-start border-4 border-primary fw-bold" : "")"
                                        style="border-left-color: #0056B3 !important; border-radius: 0;" @onclick="() => SelectConversation(chat.Id)">
                                    <!-- Avatar -->
                                    <div class="rounded-circle overflow-hidden flex-shrink-0" style="width: 44px; height: 44px; background-color: #f6f3f2; border: 1px solid #e4e2e1;">
                                        @if (!string.IsNullOrEmpty(chat.AvatarUrl))
                                        {
                                            <img src="@chat.AvatarUrl" alt="@chat.Name" class="w-100 h-100" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-6">
                                                @chat.Name.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                    </div>
                                    
                                    <!-- Meta -->
                                    <div class="flex-grow-1 min-w-0 text-start">
                                        <div class="d-flex justify-content-between align-items-baseline">
                                            <span class="text-ck-primary text-truncate fs-6 fw-bold" style="color: #003f87;">@chat.Name</span>
                                            <span class="text-ck-secondary small" style="font-size: 11px; color: #5d5f5f;">@chat.LastMessageTime</span>
                                        </div>
                                        <p class="text-ck-secondary small text-truncate mb-0 mt-1" style="font-weight: 400; color: #5d5f5f;">
                                            @chat.Messages.LastOrDefault()?.Text
                                        </p>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <span class="material-symbols-outlined text-secondary fs-1" style="color: #c6c6c7 !important;">chat</span>
                            <p class="text-ck-secondary small mt-2" style="color: #5d5f5f;">No conversations found</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Panel (Chat Conversation Area) -->
        <div class="col-md-8 col-lg-9 h-100 d-flex flex-column">
            @if (isLoading)
            {
                <div class="bg-white border rounded-4 shadow-sm h-100 d-flex flex-column align-items-center justify-content-center text-center p-5" style="border-color: #e4e2e1 !important; border-radius: 1rem !important;">
                    <div class="spinner-border text-primary shadow-sm" style="width: 3rem; height: 3rem; color: #0056B3 !important;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-ck-secondary small mt-3" style="color: #5d5f5f;">Connecting to chat...</p>
                </div>
            }
            else if (activeChat != null)
            {
                <div class="bg-white border rounded-4 shadow-sm h-100 d-flex flex-column overflow-hidden" style="border-color: #e4e2e1 !important; border-radius: 1rem !important;">
                    <!-- Chat Header -->
                    <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light" style="border-color: #e4e2e1 !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle overflow-hidden flex-shrink-0" style="width: 40px; height: 40px; background-color: #f6f3f2; border: 1px solid #e4e2e1;">
                                @if (!string.IsNullOrEmpty(activeChat.AvatarUrl))
                                {
                                    <img src="@activeChat.AvatarUrl" alt="@activeChat.Name" class="w-100 h-100" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-6">
                                        @activeChat.Name.Substring(0, 1).ToUpper()
                                    </div>
                                }
                            </div>
                            <div class="text-start">
                                <h3 class="fw-bold text-ck-primary m-0" style="font-size: 16px; color: #003f87;">@activeChat.Name</h3>
                                <div class="d-flex align-items-center gap-1.5 small">
                                    <span class="d-inline-block rounded-circle bg-success" style="width: 7px; height: 7px; border-radius: 50% !important;"></span>
                                    <span class="text-ck-secondary" style="font-size: 12px; color: #5d5f5f;">Active</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="d-flex gap-2">
                            <button class="btn btn-light btn-sm border rounded-circle p-2 d-flex align-items-center" style="border-radius: 50% !important;" title="Flag Conversation">
                                <span class="material-symbols-outlined fs-5 text-secondary">flag</span>
                            </button>
                            <button class="btn btn-light btn-sm border rounded-circle p-2 d-flex align-items-center" style="border-radius: 50% !important;" title="More Actions">
                                <span class="material-symbols-outlined fs-5 text-secondary">more_vert</span>
                            </button>
                        </div>
                    </div>

                    <!-- Context Banner (Listing Card) -->
                    <div class="px-4 py-2 border-bottom d-flex align-items-center justify-content-between" style="background-color: rgba(0, 86, 179, 0.03); border-color: #e4e2e1 !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-2 overflow-hidden border flex-shrink-0" style="width: 44px; height: 44px; border-radius: 0.25rem !important;">
                                @if (!string.IsNullOrEmpty(activeChat.ItemImageUrl))
                                {
                                    var firstUrl = activeChat.ItemImageUrl.Contains(";") ? activeChat.ItemImageUrl.Split(';')[0] : activeChat.ItemImageUrl;
                                    <img src="@firstUrl" alt="@activeChat.ItemTitle" class="w-100 h-100" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="material-symbols-outlined text-secondary fs-1" style="font-size: 32px;">image</span>
                                }
                            </div>
                            <div class="text-start">
                                <h4 class="fw-bold text-ck-primary-container m-0" style="font-size: 14px; color: #0056b3;">@activeChat.ItemTitle</h4>
                                <p class="text-ck-secondary small m-0" style="font-size: 12px; color: #5d5f5f;">PKR @activeChat.ItemPrice.ToString("N0") • @activeChat.ItemStatus</p>
                            </div>
                        </div>
                        <a href="listing/@activeChat.ItemId" class="btn btn-ck-primary btn-sm px-3 py-1.5 rounded-3 fw-bold text-decoration-none" style="background-color: #0056B3 !important; border-color: #0056B3 !important; color: white !important; border-radius: 0.5rem !important;">
                            View Listing
                        </a>
                    </div>

                    <!-- Messages Scroll Container -->
                    <div class="flex-grow-1 overflow-y-auto p-4 bg-light d-flex flex-column gap-3" style="max-height: 420px; background-color: #f8f9fa !important;">
                        <!-- Chat Messages -->
                        @foreach (var msg in activeChat.Messages)
                        {
                            <div class="d-flex flex-column @(msg.IsMe ? "align-items-end" : "align-items-start")">
                                <div class="d-flex align-items-end gap-2 max-w-75">
                                    @if (!msg.IsMe)
                                    {
                                        <div class="rounded-circle overflow-hidden flex-shrink-0 mb-1" style="width: 28px; height: 28px; background-color: #f6f3f2; border: 1px solid #e4e2e1;">
                                            @if (!string.IsNullOrEmpty(activeChat.AvatarUrl))
                                            {
                                                <img src="@activeChat.AvatarUrl" alt="@activeChat.Name" class="w-100 h-100" style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="font-size: 11px;">
                                                    @activeChat.Name.Substring(0, 1).ToUpper()
                                                </div>
                                            }
                                        </div>
                                    }
                                    
                                    <div class="p-3 shadow-sm @(msg.IsMe ? "bg-primary text-white rounded-4 rounded-bottom-end-0" : "bg-white text-dark border rounded-4 rounded-bottom-start-0")" 
                                         style="@(msg.IsMe ? "background-color: #0056B3 !important; border-radius: 1rem !important;" : "border-color: #e4e2e1 !important; border-radius: 1rem !important;")">
                                        <p class="m-0 small" style="line-height: 1.5; font-weight: 500;">@msg.Text</p>
                                    </div>
                                </div>
                                <span class="text-ck-secondary small mt-1 px-2" style="font-size: 10px; color: #5d5f5f;">@msg.Time</span>
                            </div>
                        }
                    </div>

                    <!-- Message Input Form -->
                    <div class="p-3 border-top bg-white" style="border-color: #e4e2e1 !important;">
                        <div class="d-flex align-items-center gap-2 bg-light p-2 rounded-3" style="background-color: #f6f3f2 !important; border-radius: 0.5rem !important;">
                            <button type="button" class="btn btn-link text-secondary p-1 d-flex align-items-center" title="Add File">
                                <span class="material-symbols-outlined fs-5">add_circle</span>
                            </button>
                            <button type="button" class="btn btn-link text-secondary p-1 d-flex align-items-center" title="Add Image">
                                <span class="material-symbols-outlined fs-5">image</span>
                            </button>
                            
                            <input type="text" class="form-control border-0 bg-transparent py-2.5 small flex-grow-1" style="box-shadow: none !important;"
                                   placeholder="Type a message..." @bind="typedMessage" @onkeyup="HandleKeyUp" />
                            
                            <button class="btn btn-ck-primary p-2 d-flex align-items-center justify-content-center rounded-3 hover-scale active-scale transition-all" 
                                    style="background-color: #0056B3 !important; border-color: #0056B3 !important; color: white !important; border-radius: 0.5rem !important;"
                                    @onclick="SendMessage">
                                <span class="material-symbols-outlined fs-5">send</span>
                            </button>
                        </div>
                        <p class="text-center text-ck-secondary small m-0 mt-2" style="font-size: 11px; font-weight: 500; color: #5d5f5f;">
                            🛡️ Safety Tip: Always meet in a public campus location (e.g. Main Library, Student Center) for transactions.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white border rounded-4 shadow-sm h-100 d-flex flex-column align-items-center justify-content-center text-center p-5" style="border-color: #e4e2e1 !important; border-radius: 1rem !important;">
                    <span class="material-symbols-outlined text-secondary fs-1" style="font-size: 72px; color: #c6c6c7 !important;">chat_bubble_outline</span>
                    <h3 class="fw-bold text-ck-primary mt-3" style="color: #003f87;">Select a Conversation</h3>
                    <p class="text-ck-secondary small mt-2" style="color: #5d5f5f; max-width: 400px;">
                        Select a buyer or seller from the sidebar list to view messages, share listings, and coordinate safe meeting times on campus!
                    </p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "listingId")]
    public int? ListingId { get; set; }

    private string searchQuery = "";
    private string typedMessage = "";
    private string? activeChatId;
    private bool isLoading = true;

    private List<ChatSession> conversations = new();
    private ChatSession? activeChat => conversations.FirstOrDefault(c => c.Id == activeChatId);

    private IEnumerable<ChatSession> FilteredConversations =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? conversations
            : conversations.Where(c => c.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
                                       c.ItemTitle.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private HubConnection? hubConnection;

    [CascadingParameter]
    private Task<AuthenticationState>? GetAuthenticationStateAsync { get; set; }
    private string? currentUserEmail;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            if (GetAuthenticationStateAsync != null)
            {
                var authState = await GetAuthenticationStateAsync;
                var user = authState.User;
                if (user.Identity?.IsAuthenticated == true)
                {
                    currentUserEmail = user.FindFirst(ClaimTypes.Email)?.Value;
                }
            }

            if (string.IsNullOrEmpty(currentUserEmail))
            {
                Navigation.NavigateTo("login");
                return;
            }

            // Establish real-time SignalR Connection
            var hubUrl = Navigation.ToAbsoluteUri("/chathub");
            hubConnection = new HubConnectionBuilder()
                .WithUrl(hubUrl)
                .WithAutomaticReconnect()
                .Build();

            // Handle incoming real-time messages
            hubConnection.On<string>("ReceiveMessage", async (messageJson) =>
            {
                // Reload conversations from the SQL Server database to show synchronized real-time state!
                await InvokeAsync(async () =>
                {
                    await LoadConversations();
                    StateHasChanged();
                });
            });

            await hubConnection.StartAsync();

            // Join personal real-time messaging group
            await hubConnection.SendAsync("JoinChatGroup", currentUserEmail);

            // Load initial persisted database chats
            await LoadConversations();

            // Handle Contact Seller parameter from Item Details page
            if (ListingId.HasValue)
            {
                var targetListing = await DbContext.Listings.FindAsync(ListingId.Value);
                if (targetListing != null && targetListing.SellerEmail != currentUserEmail)
                {
                    var targetId = $"session_{targetListing.SellerEmail.ToLower().Trim()}_{targetListing.Id}";
                    var existingSession = conversations.FirstOrDefault(c => c.Id == targetId);

                    if (existingSession != null)
                    {
                        activeChatId = existingSession.Id;
                    }
                    else
                    {
                        // Create a new greeting message and persist it to the database
                        var greetingMessage = new Message
                        {
                            ListingId = targetListing.Id,
                            SenderEmail = currentUserEmail,
                            ReceiverEmail = targetListing.SellerEmail,
                            Content = $"Hi! I am interested in buying your listed item: {targetListing.Title}. Is it still available?",
                            Timestamp = DateTime.UtcNow
                        };

                        DbContext.Messages.Add(greetingMessage);
                        await DbContext.SaveChangesAsync();

                        // Reload conversations to include the new thread
                        await LoadConversations();
                        activeChatId = targetId;

                        // Notify the seller in real time about the new message
                        var msgJson = JsonSerializer.Serialize(greetingMessage);
                        await hubConnection.SendAsync("SendMessage", targetListing.SellerEmail, msgJson);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error starting real-time chat dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadConversations()
    {
        if (string.IsNullOrEmpty(currentUserEmail)) return;

        // Query all message rows involving the current user
        var allMessages = await DbContext.Messages
            .Where(m => m.SenderEmail == currentUserEmail || m.ReceiverEmail == currentUserEmail)
            .OrderBy(m => m.Timestamp)
            .ToListAsync();

        // Group chats into threads by OtherPersonEmail and ListingId
        var groups = allMessages.GroupBy(m => new 
        { 
            ListingId = m.ListingId,
            OtherEmail = m.SenderEmail.Equals(currentUserEmail, StringComparison.OrdinalIgnoreCase) 
                ? m.ReceiverEmail 
                : m.SenderEmail 
        });

        var sessionsList = new List<ChatSession>();

        foreach (var grp in groups)
        {
            // Fetch listing details from listings table
            var targetListing = await DbContext.Listings.FindAsync(grp.Key.ListingId);
            
            // If the listing has been physically deleted, fallback gracefully
            var itemTitle = targetListing?.Title ?? "Deleted Item";
            var itemPrice = targetListing?.Price ?? 0;
            var itemImageUrl = targetListing?.ImageUrl ?? "";
            var itemStatus = targetListing?.Status ?? "Unavailable";

            // Fetch other person's student profile details
            var otherUser = await DbContext.Users.FirstOrDefaultAsync(u => u.Email == grp.Key.OtherEmail);
            var otherName = otherUser?.FullName ?? GetDisplayNameFromEmail(grp.Key.OtherEmail);
            var otherAvatar = otherUser?.ProfilePictureUrl ?? "";

            var chatMessages = grp.Select(m => new ChatMessage
            {
                IsMe = m.SenderEmail.Equals(currentUserEmail, StringComparison.OrdinalIgnoreCase),
                Text = m.Content,
                Time = m.Timestamp.ToLocalTime().ToString("h:mm tt")
            }).ToList();

            var lastMessageObj = grp.LastOrDefault();
            var lastTimeText = "";
            if (lastMessageObj != null)
            {
                var localTime = lastMessageObj.Timestamp.ToLocalTime();
                lastTimeText = (localTime.Date == DateTime.Today) 
                    ? localTime.ToString("h:mm tt") 
                    : localTime.ToString("MM/dd");
            }

            sessionsList.Add(new ChatSession
            {
                Id = $"session_{grp.Key.OtherEmail.ToLower().Trim()}_{grp.Key.ListingId}",
                Name = otherName,
                AvatarUrl = otherAvatar,
                LastMessageTime = lastTimeText,
                ItemId = grp.Key.ListingId,
                ItemTitle = itemTitle,
                ItemPrice = itemPrice,
                ItemImageUrl = itemImageUrl,
                ItemStatus = string.IsNullOrEmpty(itemStatus) ? "Available" : itemStatus,
                OtherEmail = grp.Key.OtherEmail,
                Messages = chatMessages
            });
        }

        conversations = sessionsList.OrderByDescending(s => s.Messages.LastOrDefault()?.Time).ToList();

        // Default to select first active chat if none is focused
        if (string.IsNullOrEmpty(activeChatId) && conversations.Any())
        {
            activeChatId = conversations.First().Id;
        }
    }

    private void SelectConversation(string id)
    {
        activeChatId = id;
        typedMessage = "";
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(typedMessage) || activeChat == null || string.IsNullOrEmpty(currentUserEmail)) return;

        var text = typedMessage.Trim();
        typedMessage = "";

        try
        {
            // Persist the message to SQL Server database
            var newMessage = new Message
            {
                ListingId = activeChat.ItemId,
                SenderEmail = currentUserEmail,
                ReceiverEmail = activeChat.OtherEmail,
                Content = text,
                Timestamp = DateTime.UtcNow
            };

            DbContext.Messages.Add(newMessage);
            await DbContext.SaveChangesAsync();

            // Refresh local UI logs instantly
            await LoadConversations();

            // Broadcast the message payload in real-time to the recipient via WebSockets (SignalR)
            if (hubConnection != null && hubConnection.State == HubConnectionState.Connected)
            {
                var msgJson = JsonSerializer.Serialize(newMessage);
                await hubConnection.SendAsync("SendMessage", activeChat.OtherEmail, msgJson);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error sending real-time message: {ex.Message}");
        }
    }

    private string GetDisplayNameFromEmail(string email)
    {
        var parts = email.Split('@');
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(parts[0].Replace(".", " "));
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection != null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    public class ChatSession
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string AvatarUrl { get; set; } = "";
        public string LastMessageTime { get; set; } = "";
        public int ItemId { get; set; }
        public string ItemTitle { get; set; } = "";
        public int ItemPrice { get; set; }
        public string ItemImageUrl { get; set; } = "";
        public string ItemStatus { get; set; } = "";
        public string OtherEmail { get; set; } = "";
        public List<ChatMessage> Messages { get; set; } = new();
    }

    public class ChatMessage
    {
        public bool IsMe { get; set; }
        public string Text { get; set; } = "";
        public string Time { get; set; } = "";
    }
}
