@page "/admin/users"
@layout Layout.AdminLayout
@using CampusKart.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext

<PageTitle>Users Management - CampusKart</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">Users Management</h1>
        <p class="text-muted mb-0">View student profiles, role distributions, and listings activity.</p>
    </div>
    <div class="search-box position-relative" style="width: 300px;">
        <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted">search</span>
        <input type="text" class="form-control ps-5 rounded-pill border-light" placeholder="Search by name or email..." @bind-value="searchText" @bind-value:event="oninput" />
    </div>
</div>

<!-- User Table Card -->
<div class="admin-card shadow-sm bg-white border border-light">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Email Address</th>
                    <th>Username</th>
                    <th class="text-center">Listings Posted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (filteredUsers == null)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading users...</span>
                            </div>
                        </td>
                    </tr>
                }
                else if (!filteredUsers.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <span class="material-symbols-outlined fs-2 mb-2">person_off</span>
                            <p class="mb-0">No users found matching your search.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in filteredUsers)
                    {
                        var count = userListingsCounts.GetValueOrDefault(user.Email ?? "", 0);
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                    {
                                        <img src="@user.ProfilePictureUrl" alt="" class="rounded-circle border border-2 border-light shadow-sm" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                            @(!string.IsNullOrEmpty(user.FullName) ? user.FullName.Substring(0, 1).ToUpper() : "U")
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 rounded-pill font-xs">Verified Student</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted font-monospace small">@user.Email</span>
                            </td>
                            <td>
                                <span class="text-dark">@user.UserName</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold">@count</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(user)">
                                    <span class="material-symbols-outlined font-sm">delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Simple Confirmation Modal -->
@if (userToDelete != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 bg-danger text-white rounded-top-4 py-3">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">warning</span>
                        Confirm User Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="text-dark mb-1 fs-5 fw-semibold">Are you sure you want to delete this account?</p>
                    <p class="text-danger fw-bold mb-3">@userToDelete.FullName (@userToDelete.Email)</p>
                    <p class="text-muted small mb-0">This will permanently remove the user and delete all of their active marketplace listings.</p>
                </div>
                <div class="modal-footer border-0 p-3 bg-light rounded-bottom-4 justify-content-between">
                    <button type="button" class="btn btn-light fw-bold px-4" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger fw-bold px-4" @onclick="DeleteUser">Delete Account</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .font-sm {
        font-size: 1.1rem;
    }
    .font-xs {
        font-size: 0.7rem;
    }
</style>

@code {
    private List<ApplicationUser>? usersList;
    private Dictionary<string, int> userListingsCounts = new();
    private string searchText = "";
    private ApplicationUser? userToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        usersList = await UserManager.Users.ToListAsync();

        // Load how many listings each user has
        userListingsCounts.Clear();
        var listings = await DbContext.Listings.ToListAsync();
        foreach (var group in listings.GroupBy(l => l.SellerEmail))
        {
            if (!string.IsNullOrEmpty(group.Key))
            {
                userListingsCounts[group.Key] = group.Count();
            }
        }
    }

    private List<ApplicationUser> filteredUsers
    {
        get
        {
            if (usersList == null) return new();
            if (string.IsNullOrWhiteSpace(searchText)) return usersList;

            var term = searchText.Trim();
            return usersList.Where(u =>
                (u.FullName != null && u.FullName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (u.Email != null && u.Email.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                (u.UserName != null && u.UserName.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    private void ConfirmDelete(ApplicationUser user)
    {
        userToDelete = user;
    }

    private void CancelDelete()
    {
        userToDelete = null;
    }

    private async Task DeleteUser()
    {
        if (userToDelete != null)
        {
            // Remove all listings by this user first
            var userListings = await DbContext.Listings
                .Where(l => l.SellerEmail == userToDelete.Email)
                .ToListAsync();
            DbContext.Listings.RemoveRange(userListings);
            await DbContext.SaveChangesAsync();

            // Delete the user
            await UserManager.DeleteAsync(userToDelete);
            
            userToDelete = null;
            await LoadUsers();
        }
    }
}
