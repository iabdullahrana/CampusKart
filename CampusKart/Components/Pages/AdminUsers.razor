            AvatarUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuCqlLoy6LYL0NjVu-JuGq6tyCis-zVlMdIwDVINDc-J_tSco5siz2nkOcUg3adahZDqOvucCQf09wvXO--yVGJ4RqDvE6SqenaJPcDn1trE3_ZE3BxFMS8h-3I7Xcjg75d-5PlbWZDD-2JUhihGVBYOmCJTr1Yp8ZKBYRcuhPl4nqKKQDigZ1O68OCEV9Q5lRbWCNGI9VViLt9nSzAAe--OHwuDSRsUCFmmzEATtB0hWcoWKaHdhb_s-FOaW5r3gxC40ZdMc03EcmI"
        });
    }

    private void ToggleUserBan(UserItem user)
    {
        if (user.Status == "Active")
        {
            user.Status = "Banned";
            alertMessage = $"User '{user.Name}' has been successfully banned.";
            alertType = "danger";
        }
        else
        {
            user.Status = "Active";
            alertMessage = $"User '{user.Name}' has been successfully restored.";
            alertType = "success";
        }
        StateHasChanged();
    }

    private void ViewProfile(UserItem user)
    {
        alertMessage = $"Simulated Action: Loading profile details for student {user.Name} ({user.Email}).";
        alertType = "info";
    }

    private void TriggerAction(string actionName)
    {
        alertMessage = $"Simulated Action: '{actionName}' triggered.";
        alertType = "info";
    }

    private void DismissAlert()
    {
        alertMessage = null;
    }

    public class UserItem
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string JoinedDate { get; set; } = "";
        public string Status { get; set; } = "Active";
        public string AvatarUrl { get; set; } = "";
    }
}
