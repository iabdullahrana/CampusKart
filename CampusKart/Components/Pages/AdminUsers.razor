            AvatarUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuBC9UaPwhRAp13L4rytv9xlKc9BtN5Bn7buoEQN3Z0LSniCn7NBd9yUkPzzFZbXETp1gU2KIBYWqgSEBWhBjT1Aj6LplrIz7TJhaWGDd6q34jtTAGEe_Yn06y99pLpB-uSM44jJoM9A5Utq1UNeHOzqn5AN7ZA46iSWv4nGKhIMo2BlkECchN2zpvK2lYBmqIZ5eczle5yCMmS5e8YpIxPoFSku_0AdpW_RNNETseqDRNZhjJW4D6Aid-pftDdolZ0O4ER6-yzhjPw"
        });

        Users.Add(new UserItem
        {
            Name = "David Chen",
            Email = "d.chen@campus.edu",
            JoinedDate = "Oct 21, 2023",
            Status = "Active",
            AvatarUrl = "https://lh3.googleusercontent.com/aida-public/AB6AXuCV1XcxuJMYcxdZ60CatcvqQdwaSahDOncm4TyfNojiT85EF-NFVd80vuf992dXWBU4fK8-9Sw1twVwVlnzPEiUW6cXKxaTyC5vgofPKPNdXtD2kZ8TJY3nAKGK_q91BxiHEtb9jbmFaCOnM41zC87G9hPL_8QFQMd0ioiMwJI-X-1UBR6utV3JALgzW4CIpN4utKAXHJlqg6pWonkbCr3CDksxBCCiXI2uytX7zVfqE8z1Ez2fZ-CQYlNhLLPsjqYxfulecP6iBF4"
