@page "/browse"
@layout Layout.UserLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@inject CampusKart.Data.ApplicationDbContext DbContext
@using Microsoft.EntityFrameworkCore

<PageTitle>CampusKart | Browse Marketplace</PageTitle>

<main class="container py-4">
    @if (!string.IsNullOrEmpty(_dbError))
    {
        <div class="alert alert-danger border-0 rounded-3 p-4 mb-4 shadow-sm" style="background-color: rgba(220, 53, 69, 0.08); color: #dc3545;" role="alert">
            <div class="d-flex align-items-center gap-2 mb-2 fw-bold">
                <span class="material-symbols-outlined fs-4">database_off</span>
                <span>Database Query Failure</span>
            </div>
            <p class="mb-0 small">
                We encountered an error connecting to the database or loading advertisements. Technical Details: <code>@_dbError</code>
            </p>
        </div>
    }
    <!-- Search Section -->
    <section class="mb-4">
        <div class="row g-2">
            <div class="col flex-grow-1 position-relative">
                <span class="material-symbols-outlined position-absolute fs-4 text-secondary" style="left: 16px; top: 50%; transform: translateY(-50%);">search</span>
                <input class="form-control py-3 pl-5 shadow-sm border border-light" 
                       style="padding-left: 48px; border-radius: 12px; font-size: 16px;" 
                       placeholder="Search items, locations, or sellers..." 
                       type="text" 
                       @bind="searchQuery" 
                       @bind:event="oninput" 
                       @onkeyup="HandleKeyUp" />
            </div>
            <div class="col-auto">
                <button class="btn btn-ck-primary py-3 px-4 shadow-sm" style="border-radius: 12px;" @onclick="ExecuteSearch">
                    Search
                </button>
            </div>
        </div>
    </section>

    <!-- Filters Section -->
    <section class="bg-ck-accent-section p-4 rounded-4 mb-4 shadow-sm">
        <div class="row g-3 align-items-end">
            <!-- Category Filter -->
            <div class="col-md-3">
                <label class="form-label fw-bold text-ck-primary-container small mb-2">Category</label>
                <select class="form-select py-2 border border-light" style="border-radius: 8px;" @bind="selectedCategory">
                    <option value="All">All Categories</option>
                    <option value="Books">Books</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Furniture">Furniture</option>
                    <option value="Stationery">Stationery</option>
                </select>
            </div>

            <!-- Price Threshold Slider -->
            <div class="col-md-5">
                <div class="d-flex justify-content-between mb-2">
                    <label class="form-label fw-bold text-ck-primary-container small mb-0">Max Price</label>
                    <span class="fw-bold text-ck-primary small">PKR @maxPrice.ToString("N0")</span>
                </div>
                <input class="form-range" type="range" min="0" max="200000" step="500" @bind="maxPrice" @bind:event="oninput" />
            </div>

            <!-- Sort By Picker -->
            <div class="col-md-4">
                <label class="form-label fw-bold text-ck-primary-container small mb-2">Sort by</label>
                <select class="form-select py-2 border border-light" style="border-radius: 8px;" @bind="sortBy">
                    <option value="Newest">Newest Listed</option>
                    <option value="LowToHigh">Price: Low to High</option>
                    <option value="HighToLow">Price: High to Low</option>
                </select>
            </div>
        </div>

        <!-- Active Filter Badge -->
        @if (selectedCategory != "All" || !string.IsNullOrEmpty(activeSearchText) || maxPrice < 200000)
        {
            <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top border-light align-items-center">
                <span class="small fw-semibold text-ck-secondary">Active Filters:</span>
                
                @if (selectedCategory != "All")
                {
                    <span class="badge bg-white text-ck-primary border border-light rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 shadow-xs font-label-md">
                        Category: @selectedCategory
                        <span class="material-symbols-outlined fs-6 text-secondary cursor-pointer hover-primary" @onclick="ClearCategoryFilter">close</span>
                    </span>
                }
                
                @if (!string.IsNullOrEmpty(activeSearchText))
                {
                    <span class="badge bg-white text-ck-primary border border-light rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 shadow-xs font-label-md">
                        Search: "@activeSearchText"
                        <span class="material-symbols-outlined fs-6 text-secondary cursor-pointer hover-primary" @onclick="ClearSearchFilter">close</span>
                    </span>
                }

                @if (maxPrice < 200000)
                {
                    <span class="badge bg-white text-ck-primary border border-light rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 shadow-xs font-label-md">
                        Price &lt;= PKR @maxPrice.ToString("N0")
                        <span class="material-symbols-outlined fs-6 text-secondary cursor-pointer hover-primary" @onclick="ClearPriceFilter">close</span>
                    </span>
                }

                <button class="btn btn-link text-ck-primary-container p-0 small fw-bold text-decoration-none ms-auto" @onclick="ResetAllFilters">
                    Clear All
                </button>
            </div>
        }
    </section>

    <!-- Grid of Listings -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mb-5">
        @if (FilteredItems.Any())
        {
            @foreach (var item in FilteredItems)
            {
                <div class="col">
                    <a href="listing/@item.Id" class="text-decoration-none text-dark d-block h-100">
                        <div class="ck-card h-100">
                            <div class="ck-card-img-wrapper">
                                <img class="ck-card-img" src="@(item.ImageUrl.Contains(";") ? item.ImageUrl.Split(';')[0] : item.ImageUrl)" alt="@item.Title" />
                                <span class="ck-badge">@item.Category</span>
                            </div>
                            <div class="ck-card-body d-flex flex-column h-100">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="ck-card-title mb-0 text-truncate text-ck-primary fw-bold" style="font-size: 18px;" title="@item.Title">@item.Title</h3>
                                    <span class="bg-ck-accent-section text-ck-primary-container px-2 py-0.5 rounded text-uppercase" style="font-size: 11px; font-weight: 700;">
                                        @item.Condition
                                    </span>
                                </div>
                                <p class="ck-card-price mb-3">@item.PriceFormatted</p>
                                
                                <div class="pt-2 mt-auto border-top border-light d-flex justify-content-between align-items-center">
                                    <span class="text-ck-secondary small fw-semibold">@item.SellerName</span>
                                    <div class="ck-card-meta small">
                                        <span class="material-symbols-outlined fs-6" style="vertical-align: middle;">location_on</span>
                                        <span>@item.Location</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <span class="material-symbols-outlined text-ck-primary-container" style="font-size: 80px; opacity: 0.15;">search_off</span>
                <h3 class="fw-bold mt-3 text-ck-primary">No Listings Found</h3>
                <p class="text-ck-secondary">We couldn't find anything matching your active filters. Try loosening your criteria!</p>
                <button class="btn btn-ck-primary mt-2" @onclick="ResetAllFilters">Reset All Filters</button>
            </div>
        }
    </div>
</main>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> GetAuthenticationStateAsync { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private List<MarketplaceItem> dbItems = new();
    private string? _dbError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var listings = await DbContext.Listings
                .Where(l => l.Status == "Active" || string.IsNullOrEmpty(l.Status))
                .OrderByDescending(l => l.DatePosted)
                .ToListAsync();
            dbItems = listings.Select(l => new MarketplaceItem
            {
                Id = l.Id,
                Title = l.Title,
                Category = l.Category,
                Condition = l.Condition,
                Price = l.Price,
                ImageUrl = l.ImageUrl,
                SellerName = l.SellerName,
                Location = l.Location,
                DatePosted = l.DatePosted
            }).ToList();
        }
        catch (Exception ex)
        {
            _dbError = ex.Message;
            Console.WriteLine($"Error loading listings from SQL Server: {ex.Message}");
        }
    }

    private string searchQuery = "";
    private string activeSearchText = "";
    private string selectedCategory = "All";
    private int maxPrice = 200000;
    private string sortBy = "Newest";

    private void ExecuteSearch()
    {
        activeSearchText = searchQuery;
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
    }

    private void ClearCategoryFilter() => selectedCategory = "All";
    private void ClearSearchFilter() => searchQuery = activeSearchText = "";
    private void ClearPriceFilter() => maxPrice = 200000;

    private void ResetAllFilters()
    {
        selectedCategory = "All";
        searchQuery = activeSearchText = "";
        maxPrice = 200000;
        sortBy = "Newest";
    }

    // Dynamic Filtered Items list
    private IEnumerable<MarketplaceItem> FilteredItems
    {
        get
        {
            var items = dbItems.AsEnumerable();

            // Search Filter (checks title, seller, and location)
            if (!string.IsNullOrWhiteSpace(activeSearchText))
            {
                items = items.Where(i => i.Title.Contains(activeSearchText, StringComparison.OrdinalIgnoreCase) ||
                                         i.SellerName.Contains(activeSearchText, StringComparison.OrdinalIgnoreCase) ||
                                         i.Location.Contains(activeSearchText, StringComparison.OrdinalIgnoreCase));
            }

            // Category Filter
            if (selectedCategory != "All")
            {
                items = items.Where(i => i.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            // Price Cap Filter
            items = items.Where(i => i.Price <= maxPrice);

            // Sorting Picker
            items = sortBy switch
            {
                "LowToHigh" => items.OrderBy(i => i.Price),
                "HighToLow" => items.OrderByDescending(i => i.Price),
                _ => items.OrderByDescending(i => i.DatePosted) // Newest
            };

            return items;
        }
    }

    // Mock Item Record representation
    public class MarketplaceItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Condition { get; set; } = "";
        public int Price { get; set; }
        public string PriceFormatted => $"PKR {Price:N0}";
        public string ImageUrl { get; set; } = "";
        public string SellerName { get; set; } = "";
        public string Location { get; set; } = "";
        public DateTime DatePosted { get; set; }
    }


}
