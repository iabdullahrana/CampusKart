@page "/login"
@layout Layout.UserLayout

@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using CampusKart.Data
@using CampusKart.Components.Account

<PageTitle>CampusKart | Google Authentication</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center my-lg-5">
        <div class="col-xl-10">
            <!-- Split Pane Auth Card -->
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 16px; border: 1px solid var(--ck-border-light) !important;">
                <div class="row g-0" style="min-height: 520px;">
                    
                    <!-- Left Column: Visual Banner (Visible only on MD screens and up) -->
                    <div class="col-md-6 d-none d-md-block position-relative">
                        <img alt="Students collaborating on campus" 
                             class="w-100 h-100 object-fit-cover" 
                             src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_RZJCH-6CQh3V_Ddnn68ZLDN-xNxcpLIRP2SO_LAqPuEA4s6kPXFSuZb1XjEHBjl7wkuj5kc7uyMitAzI1Zos9RZ6NkVkNP_u768dZr8wRULNTJMcgsytdZ6ghTTdUQ1F9U5m829fR7-eEbprtMCUVsjQEPG02C7QOLRA6IIKG82i1yT997rqxNqARZHOjQXHEoo-WXxEqiy0eUUZ8PruLFcyfdbmpjSgT6xeAosdA_D0peUSOorB72-sY5xoQMMuO5aJ-0uBFdE" />
                        <!-- overlay color tint -->
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background-color: rgba(0, 63, 135, 0.1);"></div>
                        
                        <!-- Overlay Copy -->
                        <div class="position-absolute bottom-0 start-0 p-4 m-2 text-white text-start">
                            <span class="badge text-white px-3 py-2 rounded-pill uppercase tracking-wider mb-2 fw-bold" 
                                  style="background-color: rgba(0, 63, 135, 0.85); backdrop-filter: blur(8px); letter-spacing: 0.05em; font-size: 11px;">
                                Trusted Community
                            </span>
                            <h3 class="fw-bold mt-2 m-0 lh-sm" style="text-shadow: 0 2px 4px rgba(0,0,0,0.3); font-size: 1.5rem;">
                                Built for students, by students.
                            </h3>
                        </div>
                    </div>

                    <!-- Right Column: Authentication Form -->
                    <div class="col-md-6 d-flex flex-column justify-content-center p-4 p-lg-5 bg-white text-start">
                        <!-- Status/Alert Message Banner -->
                        @if (!string.IsNullOrEmpty(_statusMessage))
                        {
                            @if (_isErrorStatus)
                            {
                                <div class="alert alert-danger border-0 rounded-3 p-3 mb-4 d-flex align-items-center gap-2 small fw-bold" style="background-color: rgba(220, 53, 69, 0.08); color: #dc3545;" role="alert">
                                    <span class="material-symbols-outlined fs-5">error</span>
                                    <span>@_statusMessage</span>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success border-0 rounded-3 p-3 mb-4 d-flex align-items-center gap-2 small fw-bold" style="background-color: rgba(40, 167, 69, 0.08); color: #28a745;" role="alert">
                                    <span class="material-symbols-outlined fs-5">check_circle</span>
                                    <span>@_statusMessage</span>
                                </div>
                            }
                        }

                        <div class="mb-4">
                            <h1 class="h2 fw-bold text-ck-primary mb-2 leading-tight" style="font-weight: 700;">
                                Join the Campus Community
                            </h1>
                            <p class="text-ck-secondary mb-0">
                                The easiest way to buy and sell on campus. Use your university Google account to get started instantly.
                            </p>
                        </div>

                        <div class="d-flex flex-column gap-3">
                            <!-- Standard External Login Form submission to Identity PerformExternalLogin endpoint -->
                            <form action="Account/PerformExternalLogin" method="post" class="w-100">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                                <button type="submit" name="provider" value="Google" class="btn btn-google-signin border border-2 py-3 rounded-3 d-flex align-items-center justify-content-center gap-3 fw-bold text-dark w-100">
                                    <svg class="bi" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path>
                                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z" fill="#EA4335"></path>
                                    </svg>
                                    <span>Continue with Google</span>
                                </button>
                            </form>

                            <!-- Horizontal Divider -->
                            <div class="d-flex align-items-center my-2">
                                <div class="flex-grow-1" style="height: 1px; background-color: var(--ck-border-light);"></div>
                                <span class="px-3 text-uppercase fw-bold text-ck-secondary" style="font-size: 11px; letter-spacing: 0.1em; font-family: 'Inter', sans-serif;">
                                    Safe & Verified
                                </span>
                                <div class="flex-grow-1" style="height: 1px; background-color: var(--ck-border-light);"></div>
                            </div>

                            <!-- Alert Card: Verification -->
                            <div class="p-3 rounded-3 d-flex gap-3 align-items-start border" 
                                 style="background-color: rgba(0, 86, 179, 0.04); border-color: rgba(0, 86, 179, 0.15) !important;">
                                <span class="material-symbols-outlined text-ck-primary-container fs-2 mt-1">verified_user</span>
                                <div>
                                    <h4 class="fs-6 fw-bold text-ck-primary m-0">University Verification</h4>
                                    <p class="text-ck-secondary mb-0 small mt-1 lh-base">
                                        We only allow verified .edu.pk emails to ensure a safe marketplace for students.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Footer legal text -->
                        <p class="mt-4 mb-0 text-center text-ck-secondary small">
                            By continuing, you agree to CampusKart's 
                            <a class="text-ck-primary-container fw-semibold text-decoration-none hover-underline" href="#">Terms of Service</a> and 
                            <a class="text-ck-primary-container fw-semibold text-decoration-none hover-underline" href="#">Privacy Policy</a>.
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-google-signin {
        border-color: var(--ck-border-color) !important; 
        background-color: #ffffff !important; 
        transition: all 0.2s ease-in-out;
    }
    .btn-google-signin:hover {
        border-color: var(--ck-primary-container) !important;
        background-color: var(--ck-accent-light) !important;
        color: var(--ck-primary-container-hover) !important;
        transform: translateY(-1px);
    }
    .btn-google-signin:active {
        transform: translateY(0);
    }
</style>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Error { get; set; }

    [SupplyParameterFromQuery]
    private string? Status { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string? _statusMessage;
    private bool _isErrorStatus = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. Read from the Identity status message cookie if present
        if (HttpContext.Request.Cookies.TryGetValue(IdentityRedirectManager.StatusCookieName, out var cookieMessage))
        {
            _statusMessage = cookieMessage;
            
            // Delete the cookie so it doesn't persist across refreshes
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
            
            if (_statusMessage.Contains("Error", StringComparison.OrdinalIgnoreCase) || 
                _statusMessage.Contains("Fail", StringComparison.OrdinalIgnoreCase))
            {
                _isErrorStatus = true;
            }
        }
        
        // 2. Fallback or override with query parameters
        if (!string.IsNullOrEmpty(Error))
        {
            _statusMessage = Error;
            _isErrorStatus = true;
        }
        else if (!string.IsNullOrEmpty(Status))
        {
            _statusMessage = Status;
            _isErrorStatus = false;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }
}
